BETACREW_PROD_SERVER_NAME=betacrew.app
BETACREW_WWW_SERVER_NAME=www.betacrew.app
BETACREW_PROD_UPSTREAM=http://betacrew-prod-app:8080
BETACREW_TLS_CERT_FILE=/etc/letsencrypt-betacrew/live/betacrew.app/fullchain.pem
BETACREW_TLS_KEY_FILE=/etc/letsencrypt-betacrew/live/betacrew.app/privkey.pem
BETACREW_ACME_WEBROOT=/var/lib/letsencrypt-betacrew
BETACREW_PROXY_LETSENCRYPT_HOST_PATH=/srv/makepad/nginx/betacrew-letsencrypt
BETACREW_PROXY_ACME_WEBROOT_HOST_PATH=/srv/makepad/nginx/betacrew-acme
MAKEPAD_PROXY_BETACREW_APP_NETWORK=makepad_betacrew_prod_app
