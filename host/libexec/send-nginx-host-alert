#!/usr/bin/env bash
set -euo pipefail
umask 077
[[ $# -eq 1 && "$1" =~ ^[a-z0-9-]{3,64}$ ]] || { echo "usage: $0 <control-name>" >&2; exit 2; }
alert_url_file=${NGINX_HOST_ALERT_URL_FILE:?root-only host alert URL file is required}
[[ -f "${alert_url_file}" && ! -L "${alert_url_file}" && "$(stat -c '%u:%a' "${alert_url_file}")" == 0:400 ]] || {
  echo "host alert URL must be a root-owned mode-0400 regular file" >&2
  exit 1
}
alert_url=$(<"${alert_url_file}")
[[ "${alert_url}" == https://* && "${alert_url}" != *[$'\r\n\t \\"']* ]] || {
  echo "host alert URL must be one canonical HTTPS URL" >&2
  exit 1
}
# Webhook URLs are bearer credentials. Stream the URL through curl's config
# input so it is absent from both the process arguments and the environment.
printf 'url = "%s"\n' "${alert_url}" | curl --config - \
  --fail --silent --show-error --proto '=https' --tlsv1.2 --max-time 15 \
  --request POST --header 'content-type: application/json' \
  --data "{\"control\":\"$1\",\"state\":\"failed\"}" >/dev/null
unset alert_url
