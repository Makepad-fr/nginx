map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $uri $vestiaire_catalog_api_route {
    /product-offers/facets /product-offers/facets;
    "~^/product-offers/[a-f0-9]{64}$" /product-offers/:offerId;
    ~^/product-offers/ /product-offers/:subresource;
    default $uri;
}

log_format vestiaire_catalog_api
    'remoteAddr=$remote_addr requestId=$upstream_http_x_request_id '
    'method=$request_method route=$vestiaire_catalog_api_route status=$status '
    'bytes=$body_bytes_sent duration=$request_time upstreamDuration=$upstream_response_time';

# OAuth callbacks contain short-lived codes in their query strings. This format
# records only the normalized URI and never logs query parameters or cookies.
log_format vestiaire_developer
    'remoteAddr=$remote_addr requestId=$upstream_http_x_request_id '
    'method=$request_method uri=$uri status=$status '
    'bytes=$body_bytes_sent duration=$request_time upstreamDuration=$upstream_response_time';
