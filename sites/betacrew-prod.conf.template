server {
    listen 80;
    listen [::]:80;
    server_name ${BETACREW_PROD_SERVER_NAME} ${BETACREW_WWW_SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root ${CATWLK_ACME_WEBROOT};
        default_type text/plain;
    }

    location / {
        return 301 https://${BETACREW_PROD_SERVER_NAME}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${BETACREW_WWW_SERVER_NAME};

    ssl_certificate ${BETACREW_TLS_CERT_FILE};
    ssl_certificate_key ${BETACREW_TLS_KEY_FILE};
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    location / { return 301 https://${BETACREW_PROD_SERVER_NAME}$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${BETACREW_PROD_SERVER_NAME};
    resolver 127.0.0.11 valid=10s ipv6=off;

    ssl_certificate ${BETACREW_TLS_CERT_FILE};
    ssl_certificate_key ${BETACREW_TLS_KEY_FILE};
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    client_max_body_size 6m;
    client_body_timeout 60s;

    location / {
        set $betacrew_prod_upstream ${BETACREW_PROD_UPSTREAM};
        proxy_pass $betacrew_prod_upstream;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
