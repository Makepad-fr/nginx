server {
    listen 80;
    server_name pluck.makepad.fr;
    location /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name pluck.makepad.fr;
    ssl_certificate /etc/letsencrypt/live/pluck.makepad.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pluck.makepad.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 300m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    access_log off;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $scan_backend http://makepad-scan-api:8080;
    location / {
        proxy_pass $scan_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 720s;
        proxy_send_timeout 720s;
    }
}
