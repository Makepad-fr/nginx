server {
    listen 80;
    listen [::]:80;
    server_name pocketgremlin.makepad.fr;

    location /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name pocketgremlin.makepad.fr;
    resolver 127.0.0.11 valid=10s ipv6=off;

    ssl_certificate /etc/letsencrypt/live/pocketgremlin.makepad.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pocketgremlin.makepad.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        set $pocket_gremlin_upstream http://makepad-landing-prod-app:8080;
        rewrite ^(.*)$ /pocket-gremlin$1 break;
        proxy_pass $pocket_gremlin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
