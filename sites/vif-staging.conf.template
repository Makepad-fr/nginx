# Explicit staging overlay. This file is not part of the ordinary shared release.
server {
    listen 80;
    listen [::]:80;
    server_name staging.vif.io domains.staging.vif.io;
    access_log /dev/stdout brio_privacy;
    error_log /dev/stderr crit;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    if ($host !~ "^(staging|domains[.]staging)[.]vif[.]io$") { return 421; }
    location /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 308 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name staging.vif.io domains.staging.vif.io;
    resolver 127.0.0.11 valid=10s ipv6=off;
    ssl_certificate /etc/letsencrypt/live/staging.vif.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.vif.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    access_log /dev/stdout brio_privacy;
    error_log /dev/stderr crit;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    # Staging owns this policy: replace upstream caching directives rather than
    # appending duplicate or contradictory fields to the response.
    proxy_hide_header Cache-Control;
    add_header Cache-Control "private, no-store" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header X-Request-ID $request_id always;
    # The CNAME routing target is not itself an approved community hostname.
    if ($host != staging.vif.io) { return 421; }
    client_max_body_size 1m;
    client_body_timeout 20s;
    limit_req_status 429;
    limit_conn_status 429;
    limit_conn brio_staging_connections 30;
    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
    proxy_set_header Connection "";
    proxy_set_header Host staging.vif.io;
    proxy_set_header X-Forwarded-Host staging.vif.io;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_set_header Forwarded "";
    proxy_set_header X-Request-ID $request_id;
    # Preserve the deployment-bound object prefix. SigV4 still authorizes each
    # request; bucket listing, other prefixes and the MinIO admin API stay closed.
    location ~ "^/brio-staging-event-photos/brio/[a-f0-9]{64}[.]jpg$" {
        client_max_body_size 11m;
        limit_except GET PUT DELETE { deny all; }
        proxy_pass http://10.80.0.2:9000;
        proxy_set_header Host staging.vif.io;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Cookie "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
    }
    location /brio-staging-event-photos/ { return 404; }
    # Exact public entry and namespaced assets; never a catch-all community router.
    location = / {
        limit_req zone=brio_staging_general burst=40 nodelay;
        set $vif_landing http://vif-landing-app:8080;
        proxy_pass $vif_landing;
        proxy_set_header Host staging.vif.io;
        proxy_set_header X-Forwarded-Host staging.vif.io;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
    }
    location ^~ /assets/vif/ {
        limit_req zone=brio_staging_general burst=40 nodelay;
        set $vif_landing http://vif-landing-app:8080;
        proxy_pass $vif_landing;
        proxy_set_header Host staging.vif.io;
        proxy_set_header X-Forwarded-Host staging.vif.io;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
    }
    location = /robots.txt { return 200 "User-agent: *\nDisallow: /\n"; }
    location = /walking-club/applications {
        limit_req zone=brio_staging_apply burst=2 nodelay;
        set $vif_walking http://brio-staging-app:8080;
        proxy_pass $vif_walking;
    }
    location ~ "^/walking-club/admin/(?:events(?:/[a-f0-9-]{36})?|photo-library)$" {
        client_max_body_size 11m;
        limit_req zone=brio_staging_general burst=40 nodelay;
        set $vif_walking http://brio-staging-app:8080;
        proxy_pass $vif_walking;
    }
    location ~ "^/walking-club(?:/|$)" {
        limit_req zone=brio_staging_general burst=40 nodelay;
        set $vif_walking http://brio-staging-app:8080;
        proxy_pass $vif_walking;
    }
    location ~ "^/platform(?:/|$)" {
        limit_req zone=brio_staging_general burst=40 nodelay;
        set $vif_platform http://vif-platform-staging-app:8080;
        proxy_pass $vif_platform;
    }
    location / { return 404; }
}
