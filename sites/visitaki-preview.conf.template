# Visitaki-only additive route. Do not attach until DNS and certificates are ready.
server {
    listen 80;
    server_name visitaki.com www.visitaki.com;
    access_log off;
    location /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 308 https://visitaki.com$request_uri; }
}
server {
    listen 443 ssl;
    server_name www.visitaki.com;
    ssl_certificate /etc/letsencrypt/live/visitaki.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/visitaki.com/privkey.pem;
    access_log off;
    return 308 https://visitaki.com$request_uri;
}
server {
    listen 443 ssl;
    server_name visitaki.com;
    ssl_certificate /etc/letsencrypt/live/visitaki.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/visitaki.com/privkey.pem;
    # Request paths may contain one-time voucher or device values.
    access_log off;
    error_log /dev/stderr crit;
    client_max_body_size 5m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    resolver 127.0.0.11 ipv6=off valid=30s;
    location / {
        set $visitaki_upstream http://visitaki-preview-api:8080;
        proxy_pass $visitaki_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
